<?xml version="1.0" encoding="utf-8"?>
<!-- Wide widget (4 cells or more): text on the left, buttons on the right. Same view ids as widget_compact. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/idle_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_mirror"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_pill"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_w_cast"
                android:tint="@color/widget_on_container" />

            <TextView
                android:id="@+id/idle_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/widget_pick_tv"
                android:textColor="@color/widget_on_container"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="44dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/widget_open"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/active_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_previous"
            android:scaleType="center"
            android:src="@drawable/ic_w_previous"
            android:tint="@color/widget_on_surface" />

        <ImageButton
            android:id="@+id/btn_play"
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_pause"
            android:scaleType="center"
            android:src="@drawable/ic_w_pause"
            android:tint="@color/widget_on_surface" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_next"
            android:scaleType="center"
            android:src="@drawable/ic_w_next"
            android:tint="@color/widget_on_surface" />

        <ImageButton
            android:id="@+id/btn_vol_down"
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_volume_down"
            android:scaleType="center"
            android:src="@drawable/ic_w_volume_down"
            android:tint="@color/widget_on_surface" />

        <ImageButton
            android:id="@+id/btn_vol_up"
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_volume_up"
            android:scaleType="center"
            android:src="@drawable/ic_w_volume_up"
            android:tint="@color/widget_on_surface" />

        <ImageButton
            android:id="@+id/btn_stop"
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_stop"
            android:scaleType="center"
            android:src="@drawable/ic_w_stop"
            android:tint="@color/widget_on_surface" />
    </LinearLayout>
</FrameLayout>
