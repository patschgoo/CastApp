<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Talking to the TV and serving it the stream over Wi-Fi -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- The same app is the receiver on Fire TV / Android TV; no touchscreen there. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Screen capture runs in a foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Casting a file keeps running with the screen off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- "Dark screen" while casting a single app (only requested when you use it) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Captures the sound of other apps (Android 10+); the microphone only when you turn on
         "Phone microphone" for mirroring -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Support tools: keep playing with the screen off, update from GitHub -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Recording TV channels in the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- The phone as a Bluetooth remote/keyboard for TV boxes (only asked for when you use it) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!-- Infrared TV remote on phones with an IR emitter -->
    <uses-permission android:name="android.permission.TRANSMIT_IR" />
    <uses-feature android:name="android.hardware.consumerir" android:required="false" />

    <!-- Needed to list apps for "Cast a single app" on Android 13 and older -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The TV receiver opens YouTube links in the TV's YouTube app -->
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.google.android.youtube.googletv" />
        <package android:name="com.amazon.firetv.youtube" />
        <package android:name="com.google.android.youtube" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".CastApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CastApp"
        android:usesCleartextTraffic="true"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-pressing the Quick Settings tile opens the app -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ProjectionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CastApp.Transparent">
            <intent-filter>
                <action android:name="io.github.patschgoo.castapp.action.CAST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- "Cast to TV" in the share sheet / "Open with" for video and music files -->
        <activity
            android:name=".CastFileActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_label"
            android:taskAffinity=""
            android:theme="@style/Theme.CastApp.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- Links shared from a browser (Firefox, Chrome...) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BrowserActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:exported="false"
            android:label="@string/web_video"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".TvChannelsActivity"
            android:exported="false"
            android:label="@string/tv_channels"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".RecordingsActivity"
            android:exported="false"
            android:label="@string/iptvx_recordings_title"
            android:launchMode="singleTop" />

        <activity
            android:name=".NetworkActivity"
            android:exported="false"
            android:label="@string/network_cloud"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".RemoteActivity"
            android:exported="false"
            android:label="@string/remote_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PinActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.CastApp.Transparent"
            android:windowSoftInputMode="adjustResize" />

        <!-- Permission / "turn on Bluetooth" / "make visible" dialogs for the hardware remotes -->
        <activity
            android:name=".remote.RemoteHelperActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.CastApp.Transparent" />

        <!-- TV receiver mode -->
        <activity
            android:name=".tv.TvHomeActivity"
            android:banner="@drawable/tv_banner"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".tv.TvPlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.CastApp.Player" />

        <service
            android:name=".tv.TvReceiverService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".tv.TvBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.CastService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|mediaPlayback|microphone" />

        <!-- Recording TV channels (reminders and planned recordings wake the receiver) -->
        <service
            android:name=".iptv.RecordingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".iptv.IptvAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Lets a TV play a recording from the phone's app folder -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.recordings"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/recording_file_paths" />
        </provider>

        <!-- Shares the debug log and the downloaded update (cache/support only) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.support.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/support_file_paths" />
        </provider>

        <!-- "Allow <phone> to cast?" on the receiver, and the code to type in for "Only paired phones" -->
        <activity
            android:name=".tv.ReceiverPromptActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.CastApp.Transparent" />

        <receiver
            android:name=".tv.ReceiverPromptReceiver"
            android:exported="false" />

        <!-- Questions from other CastApp devices: "Allow <name> to watch?", "<name> offers you <TV>", "<name> wants to cast" -->
        <activity
            android:name=".multi.MultiPromptActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.CastApp.Transparent" />

        <!-- Home-screen widget -->
        <receiver
            android:name=".widget.CastWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cast_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <service
            android:name=".tile.ReceiveTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_receive"
            android:label="@string/tile_receive_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".tile.RemoteTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_remote"
            android:label="@string/tile_remote_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.CastTileService"
            android:exported="true"
            android:icon="@drawable/ic_cast"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
